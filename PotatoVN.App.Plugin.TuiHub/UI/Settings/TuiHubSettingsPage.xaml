<UserControl
    x:Class="PotatoVN.App.Plugin.TuiHub.UI.Settings.TuiHubSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="16" Padding="16">
        <TextBlock Text="TuiHub 插件设置" />
        
        <!-- 服务器地址 -->
        <StackPanel Spacing="8">
            <TextBlock Text="服务器地址" />
            <TextBox x:Name="LibrarianUrlTextBox" 
                     PlaceholderText="http://localhost:3100"
                     Header="Librarian URL" />
        </StackPanel>

        <!-- 下载目录 -->
        <StackPanel Spacing="8">
            <TextBlock Text="下载根目录" />
            <TextBox x:Name="DownloadRootDirTextBox" 
                     PlaceholderText="例如: D:\Games\TuiHub"
                     Header="下载根目录路径" />
            <TextBlock Text="下载的文件将保存在此目录下的 downloading/temp/common 子目录中" />
        </StackPanel>

        <!-- 账户信息 -->
        <StackPanel Spacing="8">
            <TextBlock Text="账户信息" />
            <StackPanel x:Name="LoginPanel" Spacing="8">
                <TextBox x:Name="UsernameTextBox" 
                         Header="用户名"
                         PlaceholderText="输入用户名" />
                <PasswordBox x:Name="PasswordBox" 
                             Header="密码"
                             PlaceholderText="输入密码" />
                <Button x:Name="LoginButton" 
                        Content="登录"
                        Click="LoginButton_Click" />
            </StackPanel>
            
            <StackPanel x:Name="LoggedInPanel" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="AccountInfoTextBlock" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="LogoutButton" 
                            Content="退出登录"
                            Click="LogoutButton_Click" />
                    <Button x:Name="SyncButton" 
                            Content="同步应用库"
                            Click="SyncButton_Click" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- 缓存信息 -->
        <StackPanel Spacing="8">
            <TextBlock Text="缓存信息" />
            <TextBlock x:Name="CacheInfoTextBlock" />
            <Button x:Name="ClearCacheButton" 
                    Content="清除缓存"
                    Click="ClearCacheButton_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>

